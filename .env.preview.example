# Copy this file to .env.preview and replace every placeholder before running
# the private Preview container. Never commit the real value.
HIVISION_HMAC_SECRET=replace-with-a-random-preview-only-secret
HIVISION_MIN_AVAILABLE_MEMORY_MB=2048
HIVISION_MAX_INFLIGHT_REQUESTS=4
HIVISION_ASSET_UPLOAD_CONCURRENCY=4
HIVISION_ASSET_CALLBACK_ATTEMPTS=3
# Local validation may use the default tag. A VPS Preview deployment must pin
# the registry reference by digest, for example repository/image@sha256:...
HIVISION_IMAGE_REF=xhalo/hivision-legacy:phase1-local
